{
  "name": "yuncms-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build:studio": "npm run build --workspace=@yuncms/studio",
    "dev": "npm run build:studio && npm run dev --workspace=@yuncms/api",
    "dev:api": "npm run dev --workspace=@yuncms/api",
    "init": "node packages/cli/bin/yuncms.js init",
    "bootstrap": "node packages/cli/bin/yuncms.js bootstrap",
    "start": "npm run build:studio && npm run start --workspace=@yuncms/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
