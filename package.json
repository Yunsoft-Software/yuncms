{
  "name": "yuncms-workspace",
  "version": "0.1.20",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build:studio": "npm run build --workspace=@yunsoft/yuncms-studio",
    "dev": "npm run build:studio && node --watch packages/api/src/server.js",
    "dev:api": "node --watch packages/api/src/server.js",
    "init": "node packages/cli/bin/yuncms.js init",
    "bootstrap": "node packages/cli/bin/yuncms.js bootstrap",
    "start": "npm run build:studio && node packages/api/src/server.js",
    "build": "npm run build --workspaces --if-present",
    "test": "node scripts/verify.mjs full",
    "test:fast": "node scripts/verify.mjs fast",
    "test:release": "node scripts/verify.mjs release",
    "test:mcp:mysql": "node --test --test-reporter=spec test/integration/mcp-runtime.test.js",
    "test:extensions:mysql": "node --test --test-reporter=spec test/integration/extension-process.test.js",
    "test:redis:mysql": "node --test --test-reporter=spec test/integration/redis-multiprocess.test.js",
    "test:migration:mysql": "node --test --test-reporter=spec test/integration/external-auth-migration.test.js",
    "test:query:mysql": "node --test --test-reporter=spec test/integration/query-capabilities.test.js",
    "test:upgrade:mysql": "node --test --test-reporter=spec test/integration/managed-upgrade.test.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
