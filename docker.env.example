# Image and public HTTP settings
YUNCMS_IMAGE=yunsoftofficial/yuncms:2.0.2
YUNCMS_PORT=3008
YUNCMS_PUBLIC_URL=http://localhost:3008
YUNCMS_LOG_LEVEL=info
YUNCMS_TRUST_PROXY_HOPS=0

# Replace both database password values before starting the stack.
YUNCMS_DB_PASSWORD=replace-with-a-strong-database-password
YUNCMS_DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password
YUNCMS_DB_CONNECTION_LIMIT=10
# Opt-in trusted provider observation actions; raw body logging remains off.
AI_PROVIDER_OBSERVATIONS_ENABLED=false

# Optional native TOTP; generate 32 random bytes with: openssl rand -hex 32
# Keep this key stable and back it up privately.
AUTH_TOTP_KEY=

# Optional shared-edition feature controls. Leave blank for Community defaults.
# Install the signed entitlement in Studio; never configure a private signing key.
YUNCMS_LICENSE_PUBLIC_KEY=
YUNCMS_LICENSE_DOMAIN=
YUNCMS_LICENSE_INSTANCE_ID=
YUNCMS_LICENSE_TOKEN=
YUNCMS_FEATURES_DISABLED=
