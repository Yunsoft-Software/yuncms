HOST=127.0.0.1
PORT=3058
STUDIO_ORIGIN=http://127.0.0.1:3058
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yuncms_example_dev_support
DB_USER=YOUR_LOCAL_MYSQL_USER
DB_PASSWORD=YOUR_LOCAL_MYSQL_PASSWORD
