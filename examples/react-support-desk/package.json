{
  "name": "yuncms-react-support-desk-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node --env-file=.env.local scripts/setup.mjs",
    "cms": "node --env-file=.env.local node_modules/@yunsoft/yuncms/bin/yuncms.js start",
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "vite build",
    "fixture": "node --env-file=.env.local scripts/fixture-provider.mjs",
    "ai:configure": "node --env-file=.env.local scripts/configure-ai.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "node --env-file=.env.local scripts/verify.mjs",
    "verify:mcp": "node --env-file=.env.local scripts/verify-mcp.mjs"
  },
  "dependencies": {
    "@yunsoft/yuncms": "0.1.37",
    "@yunsoft/yuncms-core": "0.1.37",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4"
  }
}
