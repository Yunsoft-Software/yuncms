HOST=127.0.0.1
PORT=3008
LOG_LEVEL=info

# Keep 0 when YunCMS is reached directly. Set to the exact reverse-proxy hop count when deployed behind trusted proxies.
TRUST_PROXY_HOPS=0

# Process-local global API limiter. Health/readiness and already-served Studio assets bypass it.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_MAX_BUCKETS=10000

# Process-local permission cache. The async store contract is ready for a future shared Redis adapter.
CACHE_ENABLED=true
CACHE_STORE=memory
CACHE_TTL_MS=30000
CACHE_MAX_ENTRIES=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yuncms
DB_USER=yuncms
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=false

FILES_LOCAL_ROOT=.yuncms/uploads
FILES_MAX_UPLOAD_BYTES=26214400

# Optional S3-compatible storage (AWS S3, MinIO, R2-compatible endpoints, etc.)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Audit cleanup defaults; cleanup runs only when explicitly requested
AUDIT_RETENTION_DAYS=90
AUDIT_CLEANUP_BATCH_SIZE=1000
AUDIT_CLEANUP_MAX_BATCHES=100

# Optional SMTP delivery for password reset/email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AUTH_PUBLIC_URL=http://localhost:3008

# Process-local authentication rate limits
AUTH_LOGIN_RATE_WINDOW_MS=60000
AUTH_LOGIN_RATE_MAX=10
AUTH_REFRESH_RATE_WINDOW_MS=60000
AUTH_REFRESH_RATE_MAX=30
AUTH_ACTION_RATE_WINDOW_MS=900000
AUTH_ACTION_RATE_MAX=5

# Studio is served by the API on the same port. Override only for explicit separate-origin development.
STUDIO_ORIGIN=http://localhost:3008
