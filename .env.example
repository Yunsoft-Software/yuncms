HOST=127.0.0.1
PORT=3008
LOG_LEVEL=info

# Studio is normally served by the API on the same origin.
STUDIO_ORIGIN=http://localhost:3008

# Keep 0 when YunCMS is reached directly. Set to the exact trusted reverse-proxy hop count when deployed behind proxies.
TRUST_PROXY_HOPS=0

# Global API rate limiting. Use redis for shared counters across multiple replicas.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_STORE=memory
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_MAX_BUCKETS=10000
RATE_LIMIT_FAILURE_MODE=best-effort

# Load shedding for normal API requests.
PRESSURE_LIMIT_ENABLED=true
PRESSURE_MAX_CONCURRENT=250
PRESSURE_MAX_HEAP_PERCENT=95
PRESSURE_RETRY_AFTER_SECONDS=1

# Permission cache. Use redis when shared cache state is desired across replicas.
CACHE_ENABLED=true
CACHE_STORE=memory
CACHE_TTL_MS=30000
CACHE_MAX_ENTRIES=5000

# Redis is required when CACHE_STORE, API_RATE_LIMIT_STORE or AUTH_RATE_LIMIT_STORE is set to redis.
REDIS_URL=
REDIS_PREFIX=yuncms:default:
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yuncms
DB_USER=yuncms
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Managed CLI subprocess safety.
YUNCMS_CLI_COMMAND_TIMEOUT_MS=900000
YUNCMS_DB_TOOL_TIMEOUT_MS=7200000

# Files
FILES_LOCAL_ROOT=.yuncms/uploads
FILES_MAX_UPLOAD_BYTES=26214400

# Optional S3-compatible storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Audit cleanup defaults; cleanup runs only when explicitly requested.
AUDIT_RETENTION_DAYS=90
AUDIT_CLEANUP_BATCH_SIZE=1000
AUDIT_CLEANUP_MAX_BATCHES=100

# Optional SMTP delivery for password reset/email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AUTH_PUBLIC_URL=http://localhost:3008

# Authentication rate limits. AUTH_RATE_LIMIT_STORE defaults to API_RATE_LIMIT_STORE when omitted.
AUTH_RATE_LIMIT_STORE=memory
AUTH_LOGIN_RATE_WINDOW_MS=60000
AUTH_LOGIN_RATE_MAX=10
AUTH_REFRESH_RATE_WINDOW_MS=60000
AUTH_REFRESH_RATE_MAX=30
AUTH_ACTION_RATE_WINDOW_MS=900000
AUTH_ACTION_RATE_MAX=5

# Optional external authentication. Comma-separate provider ids, then configure AUTH_PROVIDER_<ID>_* values.
# Supported drivers: oidc, oauth2, ldap, saml.
AUTH_PROVIDERS=
AUTH_STATE_SECRET=

# Example OIDC provider named "company":
# AUTH_PROVIDERS=company
# AUTH_STATE_SECRET=replace-with-at-least-32-random-characters
# AUTH_PROVIDER_COMPANY_DRIVER=oidc
# AUTH_PROVIDER_COMPANY_LABEL=Company SSO
# AUTH_PROVIDER_COMPANY_ISSUER=https://id.example.com
# AUTH_PROVIDER_COMPANY_CLIENT_ID=
# AUTH_PROVIDER_COMPANY_CLIENT_SECRET=
# AUTH_PROVIDER_COMPANY_SCOPES=openid profile email
# AUTH_PROVIDER_COMPANY_JIT=false
# AUTH_PROVIDER_COMPANY_DEFAULT_ROLE=
# AUTH_PROVIDER_COMPANY_LINK_BY_VERIFIED_EMAIL=false
# AUTH_PROVIDER_COMPANY_ALLOW_ADMIN_LINK=false
